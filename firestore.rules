rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // StorageLoot guests write to sellers without signing in with Google: the
    // poppyStorageloot function signs them in with a Firebase custom token
    // (ids sla_… for browsers, and the same rules would hold for any other).
    // Nothing else in this project uses custom tokens. Guests may take part in
    // conversations and nothing else, so everything outside them asks for
    // member(), a signed-in person who is not a guest.
    function isGuest() {
      return request.auth.token.firebase.sign_in_provider == 'custom';
    }

    function member() {
      return request.auth != null && !isGuest();
    }

    // An inventory owner lists the emails they share with; the viewer's own
    // verified Google address on their ID token is matched against that list.
    // Emails rather than uids because nobody can look up another person's uid.
    function sharedWith(userId) {
      return request.auth.token.email != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/users/$(userId)/sharing/config)
        && request.auth.token.email.lower()
             in get(/databases/$(database)/documents/users/$(userId)/sharing/config).data.emails;
    }

    match /users/{userId}/items/{itemId} {
      // Sharing grants read only; writing stays with the owner.
      allow read: if member()
        && (request.auth.uid == userId || sharedWith(userId));
      allow write: if member() && request.auth.uid == userId;
    }

    match /users/{userId}/sharing/{docId} {
      // Only the owner sees or edits their share list. Rule get() calls run with
      // full privileges, so viewers never need read access here.
      allow read, write: if member() && request.auth.uid == userId;
    }

    // Reverse index so a recipient can discover who shared with them, which they
    // cannot do by searching other people's private share lists. Keyed by the
    // recipient's address, one document per sharer.
    match /share_index/{email}/owners/{ownerUid} {
      // Only the person whose address keys this branch can read it.
      allow read: if member()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == email;
      // The document id is the sharer's uid, so only they can add or change
      // their own entry, and ownerEmail is pinned to their token so an entry
      // cannot claim to come from someone else.
      allow create, update: if member()
        && request.auth.uid == ownerUid
        && request.resource.data.ownerEmail == request.auth.token.email.lower()
        && request.resource.data.keys().hasOnly(['ownerEmail', 'ownerName', 'sharedAt']);
      allow delete: if member() && request.auth.uid == ownerUid;
    }

    match /users/{userId}/integrations/{provider} {
      allow read: if member() && request.auth.uid == userId;
      allow write: if false;
    }

    match /users/{userId}/integration_tokens/{provider} {
      allow read, write: if false;
    }

    match /mcp_clients/{clientId} {
      allow read, write: if false;
    }

    match /auth_sessions/{code} {
      allow read, write: if false;
    }

    match /mcp_refresh_tokens/{tokenId} {
      allow read, write: if false;
    }

    // Personal Agent Protocol sign-in state for hunapuka.com: one-time codes,
    // refresh grants, and access tokens, stored by hash. Server-side only.
    match /poppy_codes/{hash} {
      allow read, write: if false;
    }

    match /poppy_grants/{hash} {
      allow read, write: if false;
    }

    match /poppy_access_tokens/{hash} {
      allow read, write: if false;
    }

    // Device Sign-In: requests waiting for approval, and the count of wrong
    // codes each account has typed.
    match /poppy_device_codes/{hash} {
      allow read, write: if false;
    }

    match /poppy_device_attempts/{uid} {
      allow read, write: if false;
    }

    // Web browsing: one-time codes that join an agent's browser to its
    // Session, and the cookie sessions those joins create.
    match /poppy_browser_codes/{hash} {
      allow read, write: if false;
    }

    match /poppy_web_sessions/{hash} {
      allow read, write: if false;
    }

    // Every JWT id the Poppy functions have accepted, so none works twice.
    match /poppy_used_jtis/{hash} {
      allow read, write: if false;
    }

    // The same for storageloot.shop's anonymous browser joins.
    match /storageloot_poppy_browser_codes/{hash} {
      allow read, write: if false;
    }

    match /storageloot_poppy_web_sessions/{hash} {
      allow read, write: if false;
    }

    // storageloot.shop agent sign-in: codes, grants, tokens, and Device
    // Sign-In requests, kept apart from hunapuka.com's.
    match /storageloot_poppy_codes/{hash} {
      allow read, write: if false;
    }

    match /storageloot_poppy_grants/{hash} {
      allow read, write: if false;
    }

    match /storageloot_poppy_access_tokens/{hash} {
      allow read, write: if false;
    }

    match /storageloot_poppy_device_codes/{hash} {
      allow read, write: if false;
    }

    match /storageloot_poppy_device_attempts/{uid} {
      allow read, write: if false;
    }

    // StorageLoot guests: accounts, browser guests' cookie sessions, and the
    // count of new guests per network. Server-side only.
    match /storageloot_accounts/{accountId} {
      allow read, write: if false;
    }

    match /storageloot_guest_sessions/{hash} {
      allow read, write: if false;
    }

    match /storageloot_guest_ip/{hash} {
      allow read, write: if false;
    }

    // ---- StorageLoot messages ------------------------------------------------
    // One two-way conversation per buyer per listing, id `{listingId}_{buyerUid}`.
    // The buyer starts it, with its first message, in one batched write. The
    // Cloud Functions write the same documents for agents (functions/src/messages.js
    // checks the same fields as these rules).

    function listingData(listingId) {
      return get(/databases/$(database)/documents/listings/$(listingId)).data;
    }

    function optionalString(data, field, max) {
      return !(field in data) || data[field] == null || (data[field] is string && data[field].size() <= max);
    }

    match /conversations/{conversationId} {
      function readField() {
        return request.auth.uid == resource.data.sellerId ? 'sellerReadAt' : 'buyerReadAt';
      }

      // A missing conversation may be looked up (it reveals nothing), so the
      // buyer can check whether they have written about a listing before.
      allow read: if request.auth != null
        && (resource == null || request.auth.uid in resource.data.participants);

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['listingId', 'listingTitle', 'listingPhoto', 'sellerId',
             'sellerDisplayName', 'buyerId', 'buyerDisplayName', 'participants', 'createdAt',
             'lastMessageAt', 'lastMessageText', 'lastSenderId', 'sellerReadAt', 'buyerReadAt', 'buyerGuest'])
        && request.resource.data.listingId is string
        && conversationId == request.resource.data.listingId + '_' + request.auth.uid
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.sellerId == listingData(request.resource.data.listingId).sellerId
        && request.resource.data.sellerId != request.auth.uid
        && listingData(request.resource.data.listingId).status == 'active'
        && request.resource.data.participants == [request.resource.data.sellerId, request.auth.uid]
        && request.resource.data.listingTitle is string
        && request.resource.data.listingTitle.size() <= 120
        && optionalString(request.resource.data, 'listingPhoto', 2000)
        && request.resource.data.sellerDisplayName is string
        && request.resource.data.sellerDisplayName.size() <= 100
        && request.resource.data.buyerDisplayName is string
        && request.resource.data.buyerDisplayName.size() <= 100
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastMessageAt == request.time
        && request.resource.data.lastSenderId == request.auth.uid
        && request.resource.data.lastMessageText is string
        && request.resource.data.lastMessageText.size() <= 140
        && request.resource.data.buyerReadAt == request.time
        && request.resource.data.sellerReadAt == null
        && (isGuest()
            ? request.resource.data.buyerGuest == true
            : !('buyerGuest' in request.resource.data));

      // A participant posts (the last* fields) or marks their own side read.
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastMessageAt', 'lastMessageText', 'lastSenderId', readField()])
        && request.resource.data.lastSenderId in resource.data.participants
        && (request.resource.data.lastSenderId == resource.data.lastSenderId
            || request.resource.data.lastSenderId == request.auth.uid)
        && (request.resource.data.lastMessageAt == resource.data.lastMessageAt
            || request.resource.data.lastMessageAt == request.time)
        && request.resource.data.lastMessageText is string
        && request.resource.data.lastMessageText.size() <= 140
        && (request.resource.data[readField()] == resource.data[readField()]
            || request.resource.data[readField()] == request.time);

      match /messages/{messageId} {
        // getAfter: the first message is written in the same batch that
        // creates the conversation.
        function convo() {
          return getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }

        function role() {
          return request.auth.uid == convo().sellerId ? 'seller' : 'buyer';
        }

        function validMessage(m) {
          return m.keys().hasOnly(['senderId', 'senderRole', 'kind', 'text', 'createdAt',
                   'offerAmount', 'currency', 'offerStatus', 'platform'])
            && m.senderId == request.auth.uid
            && m.senderRole == role()
            && m.createdAt == request.time
            && m.text is string
            && m.text.size() <= 2000
            && (
              (m.kind in ['reply', 'inquiry'] && m.text.size() > 0
                && !('offerAmount' in m) && !('platform' in m)
                && (m.kind == 'reply' || m.senderRole == 'buyer'))
              || (m.kind == 'offer' && m.senderRole == 'buyer'
                && m.offerAmount is int && m.offerAmount > 0 && m.offerAmount <= 100000000
                && m.currency is string && m.currency.size() == 3
                && m.offerStatus == 'pending' && !('platform' in m))
              || (m.kind == 'listing_request' && m.senderRole == 'buyer'
                && m.platform in ['ebay', 'craigslist'] && !('offerAmount' in m))
            );
        }

        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;

        allow create: if request.auth != null
          && request.auth.uid in convo().participants
          && validMessage(request.resource.data);

        // Only the seller answers an offer, and only once.
        allow update: if request.auth != null
          && request.auth.uid == get(/databases/$(database)/documents/conversations/$(conversationId)).data.sellerId
          && resource.data.kind == 'offer'
          && resource.data.offerStatus == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['offerStatus', 'respondedAt'])
          && request.resource.data.offerStatus in ['accepted', 'declined']
          && request.resource.data.respondedAt == request.time;
      }
    }

    // Where the seller has listed an item on another marketplace. Placeholders
    // for now: the assisted listing flows come later. Seller only. Buyer
    // requests are counted by the onListingRequest function, never by clients.
    match /listings/{listingId}/marketplaces/{platform} {
      function isSeller() {
        return member() && request.auth.uid == listingData(listingId).sellerId;
      }

      function validMarketplace(d) {
        return platform in ['ebay', 'nextdoor', 'facebook', 'craigslist']
          && d.keys().hasOnly(['status', 'url', 'externalId', 'notes', 'requestCount', 'lastRequestedAt', 'updatedAt'])
          && d.status in ['requested', 'planned', 'in_progress', 'listed', 'ended']
          && (!('url' in d) || d.url == null
              || (d.url is string && d.url.size() <= 2000 && d.url.matches('https://[^ ]+')))
          && optionalString(d, 'externalId', 200)
          && optionalString(d, 'notes', 500)
          && d.updatedAt == request.time;
      }

      allow read, delete: if isSeller();
      allow create: if isSeller()
        && validMarketplace(request.resource.data)
        && !('requestCount' in request.resource.data)
        && !('lastRequestedAt' in request.resource.data);
      allow update: if isSeller()
        && validMarketplace(request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['requestCount', 'lastRequestedAt']);
    }

    match /listings/{listingId} {
      allow read: if true;
      allow create: if member()
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && request.resource.data.price is number
        && request.resource.data.price > 0
        && request.resource.data.condition in ['new', 'like_new', 'good', 'fair', 'poor']
        && request.resource.data.category in ['tools', 'electronics', 'furniture', 'sports', 'automotive', 'household', 'clothing', 'other']
        && request.resource.data.status in ['active', 'sold', 'expired', 'draft']
        && request.resource.data.photos.size() <= 10;
      allow update: if member() && resource.data.sellerId == request.auth.uid;
      allow delete: if member() && resource.data.sellerId == request.auth.uid;
    }

    match /groups/{groupId} {
      allow read: if true;
      allow create: if member()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.type in ['container', 'box', 'storage', 'garage', 'custom']
        && (!('description' in request.resource.data) || (request.resource.data.description is string && request.resource.data.description.size() <= 300))
        && (!('photo' in request.resource.data) || request.resource.data.photo == null || (request.resource.data.photo is string && request.resource.data.photo.size() <= 2000));
      allow update: if member()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.type in ['container', 'box', 'storage', 'garage', 'custom']
        && (!('description' in request.resource.data) || (request.resource.data.description is string && request.resource.data.description.size() <= 300))
        && (!('photo' in request.resource.data) || request.resource.data.photo == null || (request.resource.data.photo is string && request.resource.data.photo.size() <= 2000));
      allow delete: if member() && resource.data.ownerId == request.auth.uid;
    }

    match /nursery_listings/{listingId} {
      allow read: if true;
      allow create: if member()
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && request.resource.data.price is number
        && request.resource.data.price > 0
        && request.resource.data.condition in ['new', 'like_new', 'good', 'fair', 'poor']
        && request.resource.data.category in ['plants', 'seeds', 'tools', 'supplies', 'pots', 'furniture', 'other']
        && request.resource.data.status in ['active', 'sold', 'expired', 'draft']
        && request.resource.data.photos.size() <= 10;
      allow update: if member() && resource.data.sellerId == request.auth.uid;
      allow delete: if member() && resource.data.sellerId == request.auth.uid;
    }

    match /nursery_groups/{groupId} {
      allow read: if true;
      allow create: if member()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80;
      allow update: if member() && resource.data.ownerId == request.auth.uid;
      allow delete: if member() && resource.data.ownerId == request.auth.uid;
    }
  }
}
